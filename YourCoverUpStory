<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Varizonest | Premium Lifestyle Store</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* === CSS RESET & BASE STYLES === */
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        html { scroll-behavior: smooth; }
        body { background-color: #f4f4f6; color: #111; }

        /* === ANNOUNCEMENT BAR === */
        .announcement-bar { background-color: #000; color: #fff; text-align: center; padding: 10px; font-size: 0.85rem; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; }

        /* === NAVBAR (GLASSMORPHISM) === */
        header { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); padding: 15px 5%; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; border-bottom: 1px solid rgba(0,0,0,0.05); transition: all 0.3s ease; }
        .logo { display: flex; align-items: center; gap: 12px; font-size: 24px; font-weight: 800; color: #000; text-decoration: none; letter-spacing: -0.5px; text-transform: uppercase; }
        .brand-logo { height: 42px; width: 42px; object-fit: cover; border-radius: 50%; box-shadow: 0 4px 10px rgba(0,0,0,0.1); border: 2px solid #fff; }
        .cart-icon-container { position: relative; cursor: pointer; font-size: 24px; color: #000; transition: transform 0.3s; }
        .cart-icon-container:hover { transform: scale(1.1); }
        .cart-badge { position: absolute; top: -8px; right: -10px; background-color: #e50914; color: white; border-radius: 50%; padding: 3px 7px; font-size: 11px; font-weight: bold; border: 2px solid #fff; }

        /* === HERO SECTION (EPIC) === */
        .hero { height: 80vh; background: linear-gradient(to right, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.3)), url('https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?auto=format&fit=crop&q=80&w=2070') center/cover no-repeat; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; color: white; padding: 0 8%; }
        .hero h1 { font-size: 4rem; margin-bottom: 15px; font-weight: 800; line-height: 1.1; letter-spacing: -1px; text-transform: uppercase; max-width: 700px; animation: fadeInUp 1s ease-out; }
        .hero p { font-size: 1.2rem; margin-bottom: 35px; font-weight: 300; max-width: 500px; color: #e0e0e0; animation: fadeInUp 1.2s ease-out; }
        .btn { padding: 15px 35px; background-color: #fff; color: #000; text-decoration: none; border: none; border-radius: 30px; font-size: 1.05rem; font-weight: 600; cursor: pointer; transition: all 0.3s ease; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 10px 20px rgba(0,0,0,0.2); animation: fadeInUp 1.4s ease-out; }
        .btn:hover { background-color: #000; color: #fff; transform: translateY(-3px); box-shadow: 0 15px 25px rgba(0,0,0,0.3); }

        @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

        /* === SHOP BY CATEGORY === */
        .categories { padding: 60px 5%; max-width: 1300px; margin: 0 auto; text-align: center; }
        .cat-grid { display: flex; justify-content: center; gap: 30px; flex-wrap: wrap; margin-top: 30px; }
        .cat-card { width: 30%; min-width: 250px; height: 200px; border-radius: 15px; overflow: hidden; position: relative; cursor: pointer; box-shadow: 0 10px 20px rgba(0,0,0,0.05); transition: transform 0.4s ease; }
        .cat-card:hover { transform: translateY(-10px); }
        .cat-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .cat-card:hover img { transform: scale(1.1); }
        .cat-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent); display: flex; align-items: flex-end; padding: 20px; }
        .cat-overlay h3 { color: #fff; font-size: 1.5rem; font-weight: 600; letter-spacing: 1px; }

        /* === PRODUCTS SECTION === */
        #products { padding: 40px 5% 80px; max-width: 1300px; margin: 0 auto; }
        .section-title { text-align: center; font-size: 2.5rem; margin-bottom: 50px; font-weight: 800; text-transform: uppercase; letter-spacing: -1px; }
        .carousel { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 30px; padding-bottom: 30px; -ms-overflow-style: none; scrollbar-width: none; }
        .carousel::-webkit-scrollbar { display: none; }
        
        .product-card { min-width: 300px; background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.05); scroll-snap-align: start; flex: 0 0 auto; display: flex; flex-direction: column; transition: all 0.4s ease; border: 1px solid rgba(0,0,0,0.02); }
        .product-card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
        .product-img { width: 100%; height: 350px; object-fit: cover; }
        .product-info { padding: 25px; display: flex; flex-direction: column; flex-grow: 1; }
        .product-cat { font-size: 0.8rem; color: #888; text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom: 5px; }
        .product-title { font-size: 1.2rem; font-weight: 700; margin-bottom: 10px; color: #000; line-height: 1.3; }
        .product-price { font-size: 1.4rem; color: #000; font-weight: 800; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;}
        .product-price span { font-size: 1rem; text-decoration: line-through; color: #aaa; font-weight: 400; }
        .product-btn { margin-top: auto; width: 100%; border-radius: 30px; background-color: #000; padding: 14px; color: white; border: none; font-weight: 600; cursor: pointer; transition: all 0.3s; font-family: 'Poppins', sans-serif; font-size: 1rem; text-transform: uppercase; letter-spacing: 1px; }
        .product-btn:hover { background-color: #333; }

        /* === TRUST ICONS === */
        .trust-section { display: flex; justify-content: space-around; flex-wrap: wrap; background-color: #000; padding: 40px 5%; color: #fff; }
        .trust-item { text-align: center; margin: 15px; width: 180px; }
        .trust-item i { font-size: 2.5rem; color: #fff; margin-bottom: 15px; }
        .trust-item h4 { font-size: 1rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; }
        .trust-item p { font-size: 0.8rem; color: #aaa; margin-top: 8px; }

        /* === CART MODAL === */
        .cart-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); display: none; justify-content: center; align-items: center; z-index: 1000; backdrop-filter: blur(5px); }
        .cart-modal { background: white; width: 95%; max-width: 500px; border-radius: 20px; padding: 30px; max-height: 90vh; overflow-y: auto; position: relative; box-shadow: 0 20px 50px rgba(0,0,0,0.3); }
        .close-cart { position: absolute; top: 20px; right: 25px; font-size: 24px; cursor: pointer; color: #000; transition: color 0.3s; }
        .close-cart:hover { color: #e50914; }
        .cart-modal h2 { margin-bottom: 25px; border-bottom: 2px solid #eee; padding-bottom: 15px; font-size: 1.8rem; font-weight: 800; text-transform: uppercase; }
        .cart-items { margin-bottom: 25px; }
        
        .cart-item { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid #eee; }
        .cart-item-info { display: flex; align-items: center; gap: 15px; }
        .cart-item-img { width: 70px; height: 70px; object-fit: cover; border-radius: 10px; border: 1px solid #eee; }
        .item-details strong { display: block; font-size: 1rem; color: #000; font-weight: 600; margin-bottom: 5px;}
        .item-details .item-price { font-size: 1rem; font-weight: 700; color: #555; }
        .remove-btn { color: #e50914; cursor: pointer; font-size: 18px; padding: 5px; transition: transform 0.2s; }
        .remove-btn:hover { transform: scale(1.2); }
        .cart-total { text-align: right; font-size: 1.5rem; font-weight: 800; margin-bottom: 25px; color: #000; }

        /* Checkout Form */
        .checkout-form { display: flex; flex-direction: column; gap: 15px; }
        .checkout-form input, .checkout-form textarea { padding: 15px; border: 1px solid #ddd; border-radius: 10px; font-size: 1rem; outline: none; font-family: 'Poppins', sans-serif; resize: none; background: #f9f9f9; transition: border 0.3s; }
        .checkout-form input:focus, .checkout-form textarea:focus { border-color: #000; background: #fff; }
        .checkout-form button { width: 100%; background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); color: white; font-weight: 700; padding: 16px; border: none; border-radius: 30px; cursor: pointer; font-size: 1.1rem; letter-spacing: 1px; transition: opacity 0.3s; text-transform: uppercase; }
        .checkout-form button:hover { opacity: 0.9; }

        /* === FOOTER === */
        footer { background-color: #111; color: #fff; padding: 60px 5% 30px; text-align: center; }
        .footer-brand { font-size: 2rem; font-weight: 800; letter-spacing: 1px; margin-bottom: 15px; text-transform: uppercase; }
        .footer-text { font-size: 1rem; color: #888; margin-bottom: 30px; }
        .social-icons { margin-bottom: 30px; }
        .social-icons a { color: #fff; text-decoration: none; margin: 0 15px; font-size: 1.8rem; transition: color 0.3s; }
        .social-icons a:hover { color: #d4af37; }
        .copyright { font-size: 0.85rem; color: #555; border-top: 1px solid #333; padding-top: 20px; }

        /* === AI CHATBOT SYSTEM === */
        .chat-float { position: fixed; width: 65px; height: 65px; bottom: 30px; right: 30px; background-color: #000; color: #FFF; border-radius: 50%; text-align: center; font-size: 28px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); z-index: 100; display: flex; justify-content: center; align-items: center; cursor: pointer; transition: all 0.3s ease; border: 2px solid #fff; }
        .chat-float:hover { transform: translateY(-5px); background-color: #333; }
        
        .chat-window { position: fixed; bottom: 110px; right: 30px; width: 350px; height: 500px; background: white; border-radius: 20px; box-shadow: 0 15px 40px rgba(0,0,0,0.2); z-index: 1000; display: none; flex-direction: column; overflow: hidden; border: 1px solid #eee; }
        .chat-header { background: #000; color: white; padding: 18px; display: flex; justify-content: space-between; align-items: center; font-weight: 600; font-size: 1.1rem; }
        .chat-body { flex: 1; padding: 20px; overflow-y: auto; background-color: #f4f4f6; display: flex; flex-direction: column; gap: 15px; scroll-behavior: smooth; }
        .bot-message, .user-message { max-width: 85%; padding: 12px 18px; border-radius: 18px; font-size: 0.95rem; line-height: 1.5; word-wrap: break-word; }
        .bot-message { background: #fff; color: #000; align-self: flex-start; border-bottom-left-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .user-message { background: #000; color: white; align-self: flex-end; border-bottom-right-radius: 4px; }
        
        .chat-input-area { display: flex; border-top: 1px solid #eee; padding: 15px; background: white; align-items: center; }
        .chat-input-area input { flex: 1; border: 1px solid #ddd; padding: 12px 15px; border-radius: 30px; outline: none; font-family: 'Poppins', sans-serif; font-size: 0.95rem; background: #f9f9f9; }
        .chat-input-area input:focus { border-color: #000; background: #fff; }
        .chat-input-area button { background: #000; color: white; border: none; width: 45px; height: 45px; border-radius: 50%; display: flex; justify-content: center; align-items: center; margin-left: 10px; cursor: pointer; transition: background 0.3s; }
        .chat-input-area button:hover { background: #333; }

        /* Responsive Design */
        @media (max-width: 768px) { 
            .hero h1 { font-size: 2.5rem; } .hero p { font-size: 1rem; } 
            .cat-card { width: 100%; }
            .product-card { min-width: 280px; } .product-img { height: 300px; } 
            .trust-item { width: 45%; } 
            .chat-window { bottom: 0; right: 0; width: 100%; height: 100%; border-radius: 0; z-index: 9999; }
            .chat-float { bottom: 20px; right: 20px; }
        }
    </style>
</head>
<body>

    <!-- Announcement Bar -->
    <div class="announcement-bar">
        ✨ PREMIERE SALE: UPTO 50% OFF ON GYM & FASHION ✨
    </div>

    <!-- Header / Navbar -->
    <header>
        <a href="#" class="logo">
            <img src="https://i.ibb.co/3DkFCY3/Screenshot-20260919-134305.jpg" alt="Varizonest Logo" class="brand-logo">
            Varizonest
        </a>
        <div class="cart-icon-container" id="cart-icon">
            <i class="fas fa-shopping-bag"></i>
            <span class="cart-badge" id="cart-count">0</span>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <h1>Elevate Your Lifestyle</h1>
        <p>Discover the finest collection of Kitchen Gadgets, Premium Gym Gear, and Trending Fashion for Men & Women.</p>
        <a href="#products" class="btn">Explore Now</a>
    </section>

    <!-- Shop by Category (NEW EPIC FEATURE) -->
    <section class="categories">
        <h2 class="section-title">Shop by Category</h2>
        <div class="cat-grid">
            <div class="cat-card" onclick="document.getElementById('products').scrollIntoView();">
                <img src="https://images.unsplash.com/photo-1556910103-1c02745a872f?auto=format&fit=crop&q=80&w=800" alt="Kitchen">
                <div class="cat-overlay"><h3>Smart Kitchen</h3></div>
            </div>
            <div class="cat-card" onclick="document.getElementById('products').scrollIntoView();">
                <img src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?auto=format&fit=crop&q=80&w=800" alt="Gym">
                <div class="cat-overlay"><h3>Gym & Fitness</h3></div>
            </div>
            <div class="cat-card" onclick="document.getElementById('products').scrollIntoView();">
                <img src="https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&q=80&w=800" alt="Fashion">
                <div class="cat-overlay"><h3>Men & Women Fashion</h3></div>
            </div>
        </div>
    </section>

    <!-- Trust Badges Section -->
    <section class="trust-section">
        <div class="trust-item">
            <i class="fas fa-award"></i>
            <h4>Premium Quality</h4>
            <p>100% Genuine Products</p>
        </div>
        <div class="trust-item">
            <i class="fas fa-shipping-fast"></i>
            <h4>Express Delivery</h4>
            <p>Pan-India fast shipping</p>
        </div>
        <div class="trust-item">
            <i class="fas fa-undo"></i>
            <h4>Easy Returns</h4>
            <p>7-Day return policy</p>
        </div>
        <div class="trust-item">
            <i class="fas fa-headset"></i>
            <h4>24/7 Support</h4>
            <p>Always here for you</p>
        </div>
    </section>

    <!-- Products Carousel Section -->
    <section id="products">
        <h2 class="section-title">New Arrivals</h2>
        <div class="carousel" id="product-carousel">
            <!-- Products will be injected here via JavaScript -->
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-brand">Varizonest</div>
        <p class="footer-text">The ultimate destination for your lifestyle needs.</p>
        <div class="social-icons">
            <a href="https://www.instagram.com/varizonest?stkn=bHlyZ2drdGxycjZj" target="_blank"><i class="fab fa-instagram"></i></a>
            <a href="https://www.facebook.com/profile.php?id=61577896403703" target="_blank"><i class="fab fa-facebook"></i></a>
        </div>
        <div class="copyright">
            &copy; 2026 Varizonest. All rights reserved.
        </div>
    </footer>

    <!-- Cart & Checkout Modal -->
    <div class="cart-overlay" id="cart-overlay">
        <div class="cart-modal">
            <i class="fas fa-times close-cart" id="close-cart"></i>
            <h2>Your Shopping Cart</h2>
            
            <div class="cart-items" id="cart-items">
                <!-- Cart items will appear here -->
            </div>
            
            <div class="cart-total" id="cart-total">
                Total: ₹0
            </div>

            <!-- Validation Error Message -->
            <div class="error-message" id="form-error">Please provide valid details (No fake details allowed).</div>

            <form class="checkout-form" id="order-form">
                <input type="text" id="customer_name" placeholder="Full Name *" minlength="3" required title="Please enter a valid full name">
                <input type="tel" id="customer_phone" placeholder="Phone Number (10 Digits) *" pattern="[0-9]{10}" maxlength="10" required title="Please enter exactly 10 digits">
                <textarea id="customer_address" placeholder="Delivery Address (Compulsory) *" rows="3" minlength="15" required title="Please provide a complete address"></textarea>
                
                <button type="submit" id="submit-btn"><i class="fab fa-instagram"></i> Send Order via Instagram DM</button>
            </form>
        </div>
    </div>

    <!-- AI CHATBOT FLOATING BUTTON -->
    <div class="chat-float" id="open-chat">
        <i class="fas fa-comment-dots"></i>
    </div>

    <!-- AI CHATBOT WINDOW -->
    <div class="chat-window" id="chat-window">
        <div class="chat-header">
            <span><i class="fas fa-robot"></i> Varizonest Assistant</span>
            <i class="fas fa-times" id="close-chat" style="cursor:pointer; padding:5px;"></i>
        </div>
        <div class="chat-body" id="chat-body">
            <div class="bot-message">Hi there! Welcome to Varizonest. Looking for Gym gear, Kitchen gadgets, or Fashion?</div>
        </div>
        <div class="chat-input-area">
            <input type="text" id="chat-input" placeholder="Type your question here...">
            <button id="send-chat"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        // --- UPDATED MULTI-NICHE PRODUCTS ---
        const products = [
            { 
                id: 1, 
                cat: "Kitchen",
                name: "12-in-1 Smart Veggie Chopper", 
                price: 499, 
                oldPrice: 999,
                image: "https://images.unsplash.com/photo-1583337265887-573516630456?auto=format&fit=crop&q=80&w=800" 
            },
            { 
                id: 2, 
                cat: "Gym & Fitness",
                name: "Premium Adjustable Dumbbell Set", 
                price: 2499, 
                oldPrice: 3999,
                image: "https://images.unsplash.com/photo-1586401100295-7a8096fd231a?auto=format&fit=crop&q=80&w=800" 
            },
            { 
                id: 3, 
                cat: "Women's Fashion",
                name: "Designer Floral Cotton Kurti", 
                price: 899, 
                oldPrice: 1499,
                image: "https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?auto=format&fit=crop&q=80&w=800" 
            },
            { 
                id: 4, 
                cat: "Men's Fashion",
                name: "Men's Dry-Fit Activewear Tee", 
                price: 599, 
                oldPrice: 1199,
                image: "https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&q=80&w=800" 
            },
            { 
                id: 5, 
                cat: "Kitchen & Home",
                name: "Electric Protein Shaker Bottle", 
                price: 799, 
                oldPrice: 1299,
                image: "https://images.unsplash.com/photo-1622483767028-3f66f32aef97?auto=format&fit=crop&q=80&w=800" 
            }
        ];

        let cart = [];

        const carousel = document.getElementById('product-carousel');
        const cartIcon = document.getElementById('cart-icon');
        const cartOverlay = document.getElementById('cart-overlay');
        const closeCartBtn = document.getElementById('close-cart');
        const cartItemsContainer = document.getElementById('cart-items');
        const cartTotalEl = document.getElementById('cart-total');
        const cartCountEl = document.getElementById('cart-count');
        const orderForm = document.getElementById('order-form');
        const errorMsg = document.getElementById('form-error');

        function renderProducts() {
            products.forEach(product => {
                const card = document.createElement('div');
                card.className = 'product-card';

                card.innerHTML = `
                    <img src="${product.image}" alt="${product.name}" class="product-img">
                    <div class="product-info">
                        <div class="product-cat">${product.cat}</div>
                        <h3 class="product-title">${product.name}</h3>
                        <div class="product-price">₹${product.price} <span>₹${product.oldPrice}</span></div>
                        <button class="product-btn" onclick="addToCartHandler(${product.id})">Add to Cart</button>
                    </div>
                `;
                carousel.appendChild(card);
            });
        }

        window.addToCartHandler = function(productId) {
            const product = products.find(p => p.id === productId);
            let cartItem = { ...product };
            cart.push(cartItem);
            updateCartUI();
            
            cartIcon.style.transform = "scale(1.4)";
            setTimeout(() => cartIcon.style.transform = "scale(1)", 200);
            
            // Modern subtle notification
            let toast = document.createElement('div');
            toast.textContent = `${product.name} added!`;
            toast.style.cssText = "position:fixed; bottom:30px; left:50%; transform:translateX(-50%); background:#000; color:#fff; padding:10px 20px; border-radius:30px; z-index:9999; font-weight:600; font-size:0.9rem; box-shadow:0 10px 20px rgba(0,0,0,0.2);";
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2000);
        }

        window.removeFromCart = function(index) {
            cart.splice(index, 1);
            updateCartUI();
        }

        function updateCartUI() {
            cartCountEl.textContent = cart.length;
            cartItemsContainer.innerHTML = '';
            let grandTotal = 0;

            if(cart.length === 0) {
                cartItemsContainer.innerHTML = '<p style="text-align:center; color:#888; font-weight: 500; margin-top:20px;">Your cart is empty.</p>';
            } else {
                cart.forEach((item, index) => {
                    grandTotal += item.price;
                    const itemEl = document.createElement('div');
                    itemEl.className = 'cart-item';
                    itemEl.innerHTML = `
                        <div class="cart-item-info">
                            <img src="${item.image}" alt="${item.name}" class="cart-item-img">
                            <div class="item-details">
                                <strong>${item.name}</strong>
                                <span class="item-price">₹${item.price}</span>
                            </div>
                        </div>
                        <span class="remove-btn" onclick="removeFromCart(${index})"><i class="fas fa-trash"></i></span>
                    `;
                    cartItemsContainer.appendChild(itemEl);
                });
            }
            cartTotalEl.textContent = `Total: ₹${grandTotal}`;
        }

        cartIcon.addEventListener('click', () => {
            cartOverlay.style.display = 'flex';
            document.body.style.overflow = 'hidden';
            errorMsg.style.display = 'none'; 
        });
        closeCartBtn.addEventListener('click', () => {
            cartOverlay.style.display = 'none';
            document.body.style.overflow = 'auto';
        });
        window.addEventListener('click', (e) => {
            if(e.target === cartOverlay) {
                cartOverlay.style.display = 'none';
                document.body.style.overflow = 'auto';
            }
        });

        orderForm.addEventListener('submit', function(e) {
            e.preventDefault();

            if(cart.length === 0) {
                alert("Please add items to your cart before ordering.");
                return;
            }

            const name = document.getElementById('customer_name').value.trim();
            const phone = document.getElementById('customer_phone').value.trim();
            const address = document.getElementById('customer_address').value.trim();

            if(name.length < 3 || phone.length !== 10 || address.length < 10) {
                errorMsg.style.display = 'block';
                return;
            }
            errorMsg.style.display = 'none';

            let orderId = 'VZ-' + Math.floor(100000 + Math.random() * 900000);

            let orderList = cart.map(item => `• ${item.name} - ₹${item.price}`).join('\n');
            let grandTotal = cart.reduce((sum, item) => sum + item.price, 0);

            let dmMessage = `🛍️ New Order - Varizonest\n` +
                            `🆔 Order ID: ${orderId}\n\n` +
                            `👤 Customer Name: ${name}\n` +
                            `📞 Phone Number: ${phone}\n` +
                            `📍 Delivery Address: ${address}\n\n` +
                            `📦 Order Items:\n${orderList}\n\n` +
                            `💰 Total Amount: ₹${grandTotal}\n\n` +
                            `Please confirm my order!`;

            try {
                const textArea = document.createElement("textarea");
                textArea.value = dmMessage;
                textArea.style.position = "fixed";
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand("copy");
                document.body.removeChild(textArea);
                
                alert("✅ Order details copied!\n\nClick OK to open our Instagram DM.\nPlease PASTE the message there to send your order.");
            } catch (err) {
                console.error('Failed to copy: ', err);
            }

            window.open("https://ig.me/m/varizonest", "_blank");

            cart = [];
            updateCartUI();
            orderForm.reset();
            cartOverlay.style.display = 'none';
            document.body.style.overflow = 'auto';
        });

        // --- AI Chatbot Logic ---
        const openChatBtn = document.getElementById('open-chat');
        const closeChatBtn = document.getElementById('close-chat');
        const chatWindow = document.getElementById('chat-window');
        const chatInput = document.getElementById('chat-input');
        const sendChatBtn = document.getElementById('send-chat');
        const chatBody = document.getElementById('chat-body');

        openChatBtn.addEventListener('click', () => {
            chatWindow.style.display = 'flex';
            openChatBtn.style.transform = 'scale(0)';
            setTimeout(() => openChatBtn.style.display = 'none', 300);
        });

        closeChatBtn.addEventListener('click', () => {
            chatWindow.style.display = 'none';
            openChatBtn.style.display = 'flex';
            setTimeout(() => openChatBtn.style.transform = 'scale(1)', 10);
        });

        function sendChatMessage() {
            const userText = chatInput.value.trim();
            if(!userText) return;

            appendMessage('user', userText);
            chatInput.value = '';

            setTimeout(() => {
                const botResponse = getBotResponse(userText.toLowerCase());
                appendMessage('bot', botResponse);
            }, 600);
        }

        sendChatBtn.addEventListener('click', sendChatMessage);
        chatInput.addEventListener('keypress', (e) => {
            if(e.key === 'Enter') sendChatMessage();
        });

        function appendMessage(sender, text) {
            const msgEl = document.createElement('div');
            msgEl.className = sender === 'user' ? 'user-message' : 'bot-message';
            msgEl.textContent = text;
            chatBody.appendChild(msgEl);
            chatBody.scrollTop = chatBody.scrollHeight; 
        }

        function getBotResponse(input) {
            if(input.includes('price') || input.includes('cost')) {
                return "Our premium products are very affordable! Check the catalog for specific pricing.";
            }
            if(input.includes('shipping') || input.includes('delivery')) {
                return "Great news! We offer FREE pan-India shipping on all orders above ₹499. Delivery usually takes 3-5 business days.";
            }
            if(input.includes('clothes') || input.includes('kurti') || input.includes('fashion') || input.includes('gym')) {
                return "We have a wide range of premium Men & Women Fashion, and top-tier Gym Accessories. Add items to your cart to order!";
            }
            if(input.includes('return') || input.includes('refund')) {
                return "We have a 7-day easy return policy. If there's an issue, DM us on Instagram @varizonest.";
            }
            if(input.includes('hello') || input.includes('hi') || input.includes('hey')) {
                return "Hello there! Welcome to Varizonest. Looking for fashion, gym gear, or kitchen gadgets today?";
            }
            if(input.includes('instagram') || input.includes('contact')) {
                return "You can reach out to us directly on Instagram @varizonest.";
            }
            return "I am still learning! For specific questions, feel free to DM us on our Instagram page: @varizonest";
        }

        renderProducts();
        updateCartUI();
    </script>
</body>
</html>
